# MySQL Database Server Sandbox Configuration
name: mysql-db
rootfs: ./rootfs
hostname: mysql-node
share_hardware: false

env:
    MYSQL_UNIX_PORT=/opt/mysql/run/mysql.sock

run:
    "if [ ! -d /opt/mysql/data/mysql ]; then /opt/mysql/bin/mysqld --initialize-insecure --datadir=/opt/mysql/data --basedir=/opt/mysql; fi"
    "/opt/mysql/bin/mysqld --datadir=/opt/mysql/data --basedir=/opt/mysql --port=3306 --socket=/opt/mysql/run/mysql.sock --mysqlx=OFF"
