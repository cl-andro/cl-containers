# cassandra-db Sandbox Configuration
name: cassandra-db
rootfs: ./rootfs
hostname: cassandra-node
share_hardware: false

env:
    JAVA_HOME=/opt/jre
    PATH=/opt/jre/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    MAX_HEAP_SIZE="512M"
    HEAP_NEWSIZE="128M"

run:
    "/opt/cassandra/bin/cassandra -f"
