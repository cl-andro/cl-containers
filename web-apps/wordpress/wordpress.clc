# WordPress PHP Application Sandbox Configuration
name: wordpress-app
rootfs: ./rootfs
hostname: wordpress-node
share_hardware: false

run:
    "/opt/php/usr/bin/php8.4 -S 0.0.0.0:8080 -t /opt/wordpress -c /opt/php/etc/php/8.4/cli/ -d extension_dir=/opt/php/usr/lib/php/20240924 -d extension=mysqli -d extension=pdo_mysql"
